# Optional. fleetopt needs no credential of its own: the optimizer and the judge
# authenticate exactly like Claude Code on this machine (claude.ai login, a key or
# gateway token in the environment or in the `env` block of ~/.claude/settings.json,
# apiKeyHelper, Bedrock/Vertex/Foundry). If `claude` works here, fleetopt works.
#
# This file only holds fleetopt's own knobs. Copy to .env (per project) or to
# ~/.config/fleetopt/env (per machine). Real environment variables win over both.
# Do not put an API key here: it would be used ahead of the machine's Claude Code
# login, and it stays out of the target's process either way.

# Model for the optimizer itself (default claude-sonnet-5). Code comprehension over
# traces + source, so don't drop below Sonnet without an eval saying it's safe.
# FLEETOPT_MODEL=claude-sonnet-5

# Model for the equivalence judge (default claude-haiku-4-5-20251001). Small job.
# FLEETOPT_JUDGE_MODEL=claude-haiku-4-5-20251001

# Reasoning effort for the optimizer (low|medium|high). Cuts its own output/thinking
# tokens; effect on finding quality unverified - test on fixture/ first.
# FLEETOPT_EFFORT=medium

# How many measurement runs execute at once (default: all of n, max 5). Concurrency
# keeps the optimizer's prompt cache warm; set 1 if the target binds a port or
# writes a shared file, or when measuring latency.
# FLEETOPT_PARALLEL=3
